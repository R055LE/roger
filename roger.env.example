# Roger — environment template. Copy to roger.env, fill in, then encrypt in place:
#   cp roger.env.example roger.env && sops -e -i roger.env
# The real roger.env (even encrypted) is git-ignored and NEVER committed.
#
# Parsed as dotenv (by `sops exec-env`), so do NOT put an inline "# comment" after a value —
# the parser keeps it as part of the value. Keep comments on their own lines, like these.

# --- required ---
# bot token. Do NOT enable Message Content / Members / Presence intents.
DISCORD_TOKEN=
# OpenRouter key — ideally dedicated, with a key-level spend limit
OPENROUTER_API_KEY=
# your Discord user ID (int)
OWNER_ID=
# the one guild this bot serves (int)
GUILD_ID=

# --- llm (comma-separated priority list; primary first, the rest are OpenRouter fallbacks) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# every MODEL_ADMIN entry MUST support tool calling (verify with the OpenRouter "Tools" filter)
MODEL_ADMIN=anthropic/claude-haiku-4.5,openai/gpt-5-mini,google/gemini-2.5-flash
MODEL_AMBIENT=google/gemini-2.5-flash-lite,openai/gpt-5-nano,mistralai/mistral-nemo
MODEL_DIGEST=google/gemini-2.5-flash-lite,openai/gpt-4.1-nano,deepseek/deepseek-v3.2
# gigabrain is read-only and meant to think hard, not be cheap — a stronger/slower model is fine
MODEL_GIGABRAIN=anthropic/claude-opus-4.5,openai/gpt-5,google/gemini-2.5-pro

# --- budgets (daily in+out tokens per brain) ---
DAILY_TOKENS_ADMIN=150000
DAILY_TOKENS_AMBIENT=40000
DAILY_TOKENS_DIGEST=30000
DAILY_TOKENS_GIGABRAIN=100000

# --- admin tool loop bounds (§2.9) ---
# hard cap on tool calls / model round-trips within a single admin request. Raise these if
# legitimate multi-step requests (e.g. remediating permissions across many categories) keep
# running into "tool-call budget" refusals.
ADMIN_MAX_TOOL_CALLS=10
ADMIN_MAX_TURNS=14

# --- gigabrain tool loop bounds (§12) ---
GIGABRAIN_MAX_TOOL_CALLS=10
GIGABRAIN_MAX_TURNS=14
# OpenRouter's unified `reasoning.effort` param (e.g. "high") — sent only if set, and only takes
# effect if MODEL_GIGABRAIN's primary model actually supports it. Leave blank to skip it entirely.
GIGABRAIN_REASONING_EFFORT=

# --- gigabrain periodic suggestions (§12) ---
# 0 disables the periodic check-in entirely (default). Set e.g. 7 for a weekly, unprompted
# server-improvement suggestion, delivered to GIGABRAIN_CHANNEL_ID if set, else DMed to OWNER_ID.
GIGABRAIN_INTERVAL_DAYS=0
GIGABRAIN_HOUR=9
# channel ID (int); leave blank to DM the owner directly instead.
GIGABRAIN_CHANNEL_ID=

# --- ambient rate limiting ---
AMBIENT_RATE_PER_USER=5
AMBIENT_RATE_WINDOW_S=600
AMBIENT_GLOBAL_HOURLY=30

# --- digest ---
# comma-separated RSS/Atom URLs. Seeds Roger's feed list on first run only; after that Roger
# curates it live (suggest/add/remove), so edits here return only if the list is fully cleared.
DIGEST_FEEDS=
# target channel ID (int)
DIGEST_CHANNEL_ID=
# local hour 0-23
DIGEST_HOUR=8

# --- personal digest ---
# comma-separated RSS/Atom URLs, curated separately from the public digest above. Seeds once, same
# rule as DIGEST_FEEDS. Dedup is shared with the public digest's feed list (keyed on URL+entry, not
# per-list) -- avoid adding the same feed to both lists, or only whichever runs first each day
# actually delivers it.
PERSONAL_DIGEST_FEEDS=
# unset = DM the owner directly; set = post there instead (same shape as DIGEST_CHANNEL_ID)
PERSONAL_DIGEST_CHANNEL_ID=
# local hour 0-23
PERSONAL_DIGEST_HOUR=7
TZ=America/Detroit

# --- ops ---
# channel ID (int) where Roger posts a one-line boot self-report (online + permission state).
# Leave blank to disable the post; the same check still goes to the logs regardless.
OPS_CHANNEL_ID=

# --- runtime ---
DB_PATH=/data/roger.db
LOG_LEVEL=INFO
